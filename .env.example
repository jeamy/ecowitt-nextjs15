# =============================================================================
# ecowitt-nextjs15 — environment variables
# Copy this file to `.env` and adjust. Every variable the app / PI sidecar
# actually reads is listed here; defaults shown are the built-in fallbacks.
# `NEXT_PUBLIC_*` values are exposed to the browser bundle.
#
# NOTE: Ecowitt API credentials are NOT set here — copy `eco.example.ts` to
# `eco.ts` and fill in applicationKey / apiKey / mac / server.
# =============================================================================

# -----------------------------------------------------------------------------
# Server / runtime
# -----------------------------------------------------------------------------
## HTTP port for the Next.js server (used by docker-compose / `next start`).
PORT=3010
## Set by the framework; only override if you know why. development | production | test
# NODE_ENV=production

# -----------------------------------------------------------------------------
# Realtime data refresh
# -----------------------------------------------------------------------------
## Server-side background poller interval in ms. Min 10000. Default 300000 (5 min).
RT_REFRESH_MS=300000
## Client-side refresh for the Realtime tab in ms. Default 300000 (5 min). Sent to the browser.
NEXT_PUBLIC_RT_REFRESH_MS=300000

# -----------------------------------------------------------------------------
# Forecast providers
# -----------------------------------------------------------------------------
## Station ID used for automatic daily forecast storage across all sources
## (Geosphere, Meteoblue, Open-Meteo, OpenWeatherMap). Use "ALL" to store every
## configured station. Default 11035 (Wien Hohe Warte).
## Station list: https://dataset.api.hub.geosphere.at/v1/station/current/tawes-v1-10min/metadata
FORECAST_STATION_ID=11035
## OpenWeatherMap key for the 5-day / 3-hour forecast (free): https://openweathermap.org/api
OPENWEATHER_API_KEY=
## Meteoblue key for the 7-14 day forecast (free, non-commercial): https://www.meteoblue.com/en/weather-api
METEOBLUE_API_KEY=

# -----------------------------------------------------------------------------
# Admin API auth (protects /api admin routes)
# -----------------------------------------------------------------------------
## Bearer / x-admin-token value required by admin endpoints. If unset those routes return 503.
ADMIN_API_TOKEN=
## Legacy fallback, only used when ADMIN_API_TOKEN is unset.
# WEATHER_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# Statistics AI chat (Next.js side)
# -----------------------------------------------------------------------------
## Master switch. Must be the literal string "true" to enable the feature.
STATISTICS_CHAT_ENABLED=false
## Max length of a single user message. Min 100. Default 1000.
STATISTICS_CHAT_MAX_MESSAGE_LENGTH=1000
## Conversation turns forwarded to the sidecar as context. Clamped 1-50. Default 12.
STATISTICS_CHAT_MAX_HISTORY=12
## Conversation turns kept in on-disk history. Clamped 1-50. Default 24.
STATISTICS_CHAT_HISTORY_LIMIT=24
## Set to "false" to disable the answer cache. Any other value keeps it on.
STATISTICS_CHAT_CACHE_ENABLED=true
## Cache entry TTL in ms. 0 = never expires. Default 0.
STATISTICS_CHAT_CACHE_TTL_MS=0
## Directory (relative to project root) for chat history / cache files. Default data/statistics_chat.
STATISTICS_CHAT_STORAGE_DIR=data/statistics_chat
## Shared conversation id used by the chat UI. Default "ecowitt-statistics-chat-shared". Sent to the browser.
# NEXT_PUBLIC_STATISTICS_CHAT_CONVERSATION_ID=ecowitt-statistics-chat-shared

# -----------------------------------------------------------------------------
# PI sidecar — how the Next.js app reaches the sidecar service
# -----------------------------------------------------------------------------
## Base URL of the sidecar HTTP server. Default http://pi-sidecar:3001 (docker-compose service name).
PI_SIDECAR_URL=http://pi-sidecar:3001
## Provider: openai | anthropic | ollama
PI_SIDECAR_PROVIDER=openai
## Model id. Provider defaults: openai -> gpt-4o-mini, anthropic -> claude-haiku-4-5, ollama -> llama3.1:8b
PI_SIDECAR_MODEL=gpt-4o-mini
## Client-side request timeout in ms (Next.js -> sidecar). Min 1000. Default 120000.
PI_SIDECAR_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# PI sidecar — server process (read inside the pi-sidecar container)
# -----------------------------------------------------------------------------
## Bind address / port for the sidecar HTTP server. Defaults 0.0.0.0 : 3001.
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=3001
## Fallback model when PI_SIDECAR_MODEL and the request body both omit one. Optional.
AI_AGENT_MODEL=
## Retries on transient upstream errors (429 / 5xx / network). Default 3.
PI_SIDECAR_MAX_RETRIES=3
## Max output tokens per answer. Default 1200.
PI_SIDECAR_MAX_TOKENS=1200

# -----------------------------------------------------------------------------
# PI sidecar — provider credentials & endpoints (consumed only by the sidecar)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
## Optional custom base URLs (OpenAI-compatible proxy / self-hosted gateway).
## Trailing /v1/messages or /chat/completions is stripped automatically.
PI_SIDECAR_OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
PI_SIDECAR_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

## --- Local Ollama models (no API key required) ---
## Minimal setup: PI_SIDECAR_PROVIDER=ollama and PI_SIDECAR_MODEL=<ollama tag>.
## Setting PI_SIDECAR_OLLAMA_BASE_URL also enables Ollama regardless of provider.
## From the sidecar container, reach the host's Ollama via host.docker.internal
## (docker-compose already adds the host-gateway alias). Default http://localhost:11434/v1.
# PI_SIDECAR_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
## Extra Ollama tags selectable per request (comma-separated). Optional.
# PI_SIDECAR_OLLAMA_MODELS=llama3.1:8b,qwen2.5-coder:7b
## Placeholder key sent to Ollama (it ignores the value). Default "ollama".
# PI_SIDECAR_OLLAMA_API_KEY=ollama
## Context window advertised for Ollama models. Min 4096. Default 131072.
# PI_SIDECAR_OLLAMA_CONTEXT_WINDOW=131072
