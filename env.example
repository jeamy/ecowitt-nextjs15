# Demo environment variables for realtime refresh
# Copy to .env and adjust as needed
## Server-side background poller interval (ms). Min 10000. Default 300000 (5 min).
RT_REFRESH_MS=300000
## Client-side refresh for the Realtime tab (ms). Default 300000 (5 min).
NEXT_PUBLIC_RT_REFRESH_MS=300000
## Only if you also want the API route (/api/rt) to write to DNT (normally OFF to avoid duplicates): set to 1 to enable
# RT_ARCHIVE_FROM_API=1

## Statistics chat / Ecowitt PI sidecar
STATISTICS_CHAT_ENABLED=false
PI_SIDECAR_URL=http://pi-sidecar:3001
PI_SIDECAR_PROVIDER=openai
PI_SIDECAR_MODEL=gpt-4o-mini
PI_SIDECAR_TIMEOUT_MS=120000
## PI sidecar server bind settings (used inside the sidecar container). Default: 0.0.0.0:3001
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=3001
## Fallback model when PI_SIDECAR_MODEL is not set. Optional.
AI_AGENT_MODEL=
STATISTICS_CHAT_MAX_MESSAGE_LENGTH=1000
STATISTICS_CHAT_MAX_HISTORY=12
STATISTICS_CHAT_HISTORY_LIMIT=24
STATISTICS_CHAT_CACHE_ENABLED=true
STATISTICS_CHAT_CACHE_TTL_MS=0
STATISTICS_CHAT_STORAGE_DIR=data/statistics_chat

## Provider keys are consumed only by the internal PI sidecar.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
## Optional custom base URLs for provider APIs (e.g. OpenAI-compatible proxy).
PI_SIDECAR_OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
PI_SIDECAR_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

## OpenWeatherMap API Key for 5-day forecast (FREE - get key at https://openweathermap.org/api)
## Uses the free "5 Day / 3 Hour Forecast" API
OPENWEATHER_API_KEY=your_api_key_here

## Meteoblue API Key for 7-14 day forecast (FREE - get key at https://www.meteoblue.com/en/weather-api)
## Register for free, confirm non-commercial use, and get instant access
METEOBLUE_API_KEY=your_api_key_here

## Forecast Station ID for daily automatic forecast storage (default: 11035 - Wien Hohe Warte)
## This station is used for all forecast sources (Geosphere, Meteoblue, Open-Meteo, OpenWeatherMap)
## Find station IDs at: https://dataset.api.hub.geosphere.at/v1/station/current/tawes-v1-10min/metadata
## Popular stations: 11035 (Wien), 11120 (Innsbruck), 11320 (Graz), 11150 (Salzburg), 11240 (Klagenfurt)
FORECAST_STATION_ID=11035
